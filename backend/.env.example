# 이 프로젝트는 DB를 직접 띄우지 않는다. 이미 운영 중인 PostgreSQL에 접속한다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=skon
DB_PASSWORD=skon
DB_NAME=skon
DB_SCHEMA=skon

# 테스트 전용 스키마. 매 실행마다 drop_all 후 재생성되므로 DB_SCHEMA와 절대 같으면 안 된다.
TEST_DB_SCHEMA=skon_test

# 32바이트 이상으로 설정할 것. 짧으면 PyJWT가 경고한다.
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production
