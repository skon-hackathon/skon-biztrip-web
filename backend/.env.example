# 이 프로젝트는 DB를 직접 띄우지 않는다. 이미 운영 중인 PostgreSQL에 접속한다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=skon
DB_PASSWORD=skon
DB_NAME=skon
DB_SCHEMA=skon

# `user` 테이블만 사는 스키마. 다른 프로젝트와 계정을 공유하려고 public에 둔다.
# 상대 프로젝트와 이 값 + JWT_SECRET이 같아야 토큰과 계정이 상호 통용된다.
USER_DB_SCHEMA=public

# 테스트 전용 스키마. 매 실행마다 drop_all 후 재생성된다.
# public·DB_SCHEMA·USER_DB_SCHEMA와 달라야 하며, 이름에 독립된 test 구간이 있어야 한다.
TEST_DB_SCHEMA=skon_test

# 32바이트 이상으로 설정할 것. 짧으면 PyJWT가 경고한다.
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production
